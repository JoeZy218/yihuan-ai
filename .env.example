# ==============================================
# 异环AI战术教学助手 - API配置文件
# ==============================================
# 将此文件复制为 .env 并填写实际的API密钥

# ------------------------------
# LLM API 配置（必填）
# ------------------------------
# DeepSeek API 密钥（需要在 DeepSeek 官网注册获取）
# 注册地址：https://platform.deepseek.com/
LLM_API_KEY=your_deepseek_api_key_here

# API 地址（通常不需要修改）
LLM_API_URL=https://api.deepseek.com/v1/chat/completions

# 模型名称（通常不需要修改）
LLM_MODEL=deepseek-chat

# 请求超时时间（秒）
LLM_TIMEOUT=10

# ------------------------------
# 服务配置（可选）
# ------------------------------
# 后端服务端口
BACKEND_PORT=8000

# 前端服务端口
FRONTEND_PORT=3000